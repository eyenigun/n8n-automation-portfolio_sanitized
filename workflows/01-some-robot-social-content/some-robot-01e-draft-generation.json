      "id": "fee24cfc-b283-4526-ae4d-deedafe00a02",
      "name": "Get File Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1232,
        400
      ],
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "<your slackApi>"
        }
      },
      "notes": "Fetches the uploaded file's share info so we can find the ts of the auto-posted upload announcement and delete just that message (keeping the file itself shared to the channel so its permalink stays viewable).",
      "disabled": false
    },
    {
      "parameters": {
        "jsCode": "const file = $json.file || {};\nconst shares = file.shares || {};\nconst channelId = '<SLACK_ID>';\nlet ts = null;\nif (shares.public && shares.public[channelId] && shares.public[channelId][0]) {\n  ts = shares.public[channelId][0].ts;\n} else if (shares.private && shares.private[channelId] && shares.private[channelId][0]) {\n  ts = shares.private[channelId][0].ts;\n}\nreturn { json: { channel: channelId, ts } };",
        "mode": "runOnceForEachItem"
      },
      "id": "f772d0b2-f0f8-4827-a80f-4688d1cdff55",
      "name": "Extract Upload Message Ts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        400
      ],
      "notes": "Finds the ts of the message Slack auto-posted when the file was shared to the review channel, so it can be deleted next.",
      "disabled": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.delete",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.channel, ts: $json.ts }) }}",
        "options": {}
      },
      "id": "ae567716-c5cc-4abd-a402-495886405201",
      "name": "Delete Image Upload Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1680,
        400
      ],
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "<your slackApi>"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Deletes the auto-posted upload announcement so the image only appears once, via the unfurled permalink in the draft review message. Errors here (e.g. ts not found yet) don't block the pipeline.",
      "disabled": false
    },
    {
      "parameters": {
        "amount": 10
      },
      "id": "ba9e98b0-2cde-4aa4-a284-420704a8c5b5",
      "name": "Wait for Share to Register",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1008,
        400
      ],
      "webhookId": "00000000-0000-0000-0000-000000000000",
      "notes": "Slack's files.info can return an empty 'shares' object if queried immediately after upload -- the share metadata takes a moment to propagate. This short wait avoids a race condition that left the redundant upload announcement undeleted.",
      "disabled": false
    }
