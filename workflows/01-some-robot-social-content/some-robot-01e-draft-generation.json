        "jsCode": "const parsed = $json.output?.[0]?.content?.[0]?.text;\n\nif (!parsed || typeof parsed !== 'object') {\n  throw new Error('No parsed JSON object found in LLM response.');\n}\n\nreturn {\n  json: {\n    topicId: $('Get Approved Topics').item.json.id,\n    core_content: parsed.core_content || '',\n    image_brief: parsed.image_brief || ''\n  }\n};"
