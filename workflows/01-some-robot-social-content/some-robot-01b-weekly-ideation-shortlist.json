      "id": "3b8139c8-5d48-49e9-863b-773bc3d2c1e4",
      "name": "Get Topic Memory",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        -272,
        1328
      ],
      "notes": "Returns every existing row so we can pull the 'topic' column as the used-topics list for dedup. No filter = topic memory covers all statuses, not just Published."
    },
    {
      "parameters": {
        "jsCode": "// Build a single prompt-ready item combining:\n//  - RSS candidates (from 'Cap to 15 Items')\n//  - Slack-submitted candidates (from 'Get New Slack Ideas')\n//  - existing topics for dedup (from 'Get Topic Memory')\n\nconst rssItems = $items('Cap to 7 Items').map(i => ({\n  source_type: 'rss',\n  title: i.json.title,\n  link: i.json.link,\n  contentSnippet: (i.json.contentSnippet || '').slice(0, 300)\n}));\n\nconst slackItems = $items('Get New Slack Ideas').map(i => ({\n  source_type: 'slack',\n  row_id: i.json.id,\n  topic: i.json.topic\n}));\n\nconst candidates = [...rssItems, ...slackItems].map((c, index) => ({ ...c, index }));\n\nconst existingTopics = $items('Get Topic Memory').map(i => i.json.topic).filter(Boolean);\n\nreturn [{\n  json: {\n    candidates,\n    existing_topics: existingTopics\n  }\n}];"
      },
      "id": "6ec735dc-ae69-440f-b638-7af8fb34670e",
      "name": "Build Prompt Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        1104
      ]
    },
    {
      "parameters": {
        "jsCode": "const candidates = $json.output?.[0]?.content?.[0]?.text?.candidates;\n\nif (!Array.isArray(candidates)) {\n  throw new Error(\"No candidates array found in the LLM response.\");\n}\n\nconst originalCandidates = $('Build Prompt Data').item.json.candidates;\n\nreturn candidates.map(candidate => {\n  const original = (typeof candidate.index === 'number') ? originalCandidates[candidate.index] : null;\n  const source_url = (original && original.source_type === 'rss') ? original.link : null;\n  return { json: { ...candidate, source_url } };\n});"
      },
      "id": "7bbe4097-ac38-4130-9dd3-f178dc5e40a8",
      "name": "Parse LLM Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        1104
      ],
      "notes": "One n8n item per candidate, each with source_type/row_id/topic/rationale/keep."
    },
