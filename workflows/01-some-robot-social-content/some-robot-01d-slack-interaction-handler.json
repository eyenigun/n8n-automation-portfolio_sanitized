      "name": "Webhook",
      "webhookId": "00000000-0000-0000-0000-000000000000"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"ok\": true\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        -7568,
        3424
      ],
      "id": "974cfe9f-e516-45c2-b765-91fd655d34b4",
      "name": "Respond to Webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nlet payload;\ntry {\n  payload = JSON.parse(body.payload || '{}');\n} catch (e) {\n  return [{ json: { valid: false, error: 'Could not parse payload', raw: body } }];\n}\n\nconst action = (payload.actions && payload.actions[0]) || {};\nconst blockId = action.block_id || '';\nconst actionId = action.action_id || '';\nconst selectedOptions = action.selected_options || [];\n\nconst topicMatch = blockId.match(/^topic_(\\d+)$/);\nconst draftMatch = blockId.match(/^draft_(\\d+)$/);\nconst publishMatch = blockId.match(/^publish_(\\d+)$/);\nconst linkedinMatch = blockId.match(/^linkedin_(\\d+)$/);\nconst topicId = topicMatch ? Number(topicMatch[1]) : (draftMatch ? Number(draftMatch[1]) : (publishMatch ? Number(publishMatch[1]) : (linkedinMatch ? Number(linkedinMatch[1]) : null)));\n\nconst validActionIds = ['approve_topic', 'approve_draft', 'regenerate_draft', 'approve_publish', 'regenerate_adaptation', 'mark_linkedin_published'];\n\nreturn [{\n  json: {\n    valid: Boolean(topicId && validActionIds.includes(actionId)),\n    actionId,\n    topicId,\n    approved: selectedOptions.length > 0,\n    user: payload.user ? payload.user.username : null\n  }\n}];"
      },
      "id": "76c5ed47-cd86-4fd3-a140-3736aadab74b",
      "name": "Parse Slack Interaction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -7568,
        3696
      ],
      "notes": "Parses the Slack block_actions payload (form-urlencoded 'payload' field) and extracts the topic id (from block_id) and whether it was checked or unchecked."
    },
